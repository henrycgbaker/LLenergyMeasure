# syntax=docker/dockerfile:1
# ============================================================
# Transformers engine — engine substrate on PyTorch base image
# ============================================================
# Uses pytorch/pytorch as the tensor substrate, then layers the HuggingFace
# Transformers engine substrate (transformers + FA2 + FA3 + accelerate +
# bitsandbytes + calflops + sentencepiece + einops) on top. CUDA and PyTorch
# compatibility is guaranteed by the upstream image.
#
# The llenergymeasure package itself is NOT installed into this image. The
# project source is bind-mounted at runtime by the caller — see the engine-
# invariants/engine-schemas workflows and docs/development.md for the canonical
# `docker run -v $(pwd):/repo -e PYTHONPATH=/repo/src:/repo --entrypoint python3`
# pattern. This makes image rebuilds depend only on the engine substrate,
# not on project source edits.
#
# Usage (CI builds inline; local builds via `make docker-build-transformers`):
#   docker build -f docker/Dockerfile.transformers -t llenergymeasure-transformers .
#
# Version pin policy: update PYTORCH_VERSION on each milestone release.
# TRANSFORMERS_VERSION comes from engine_versions/transformers.yaml SSOT.
# ============================================================
ARG PYTORCH_VERSION=2.5.1-cuda12.4-cudnn9-runtime
ARG PYTORCH_DEVEL_VERSION=2.5.1-cuda12.4-cudnn9-devel

# Source of truth: engine_versions/transformers.yaml `library.current_version`.
# Renovate authors that file; CI passes the value via
# `--build-arg TRANSFORMERS_VERSION=$(yq '.library.current_version' engine_versions/transformers.yaml)`
# at build time. The ARG default below is a fallback for local manual builds only.
ARG TRANSFORMERS_VERSION=4.57.3

# Build stage: compile flash-attn FA2 + FA3 (needs nvcc from devel image)
# FA2 = standard flash-attn pip package.
# FA3 = separate build from flash-attn repo's hopper/ directory; produces
#        the flash_attn_interface top-level package that transformers checks.
# SM 8.0 = A100 (Ampere), 9.0 = H100 (Hopper).
# 9.0+PTX includes PTX IR for forward compatibility with future architectures.
# Set INSTALL_FA3=false to skip FA3 (saves ~1 hour build time on cold builds).
ARG FLASH_ATTN_VERSION=v2.8.3
ARG INSTALL_FA3=true
FROM pytorch/pytorch:${PYTORCH_DEVEL_VERSION} AS builder
ARG FLASH_ATTN_VERSION
ARG INSTALL_FA3
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV TORCH_CUDA_ARCH_LIST="8.0;9.0+PTX"

# FA2: install from PyPI (cache mount persists compiled wheel across rebuilds)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system flash-attn --no-build-isolation

# FA3: build hopper extensions from source (produces flash_attn_interface + flash_attn_3_cuda)
# MAX_JOBS controls parallel nvcc processes (ninja -j). Default 32 balances speed vs memory
# (~128 GB peak). Override with --build-arg MAX_JOBS=N for constrained hosts.
# Set via ENV so the RUN command text stays stable (preserving build cache keys).
# Skipped when INSTALL_FA3=false (e.g. CI smoke tests).
ARG MAX_JOBS=32
ENV MAX_JOBS=${MAX_JOBS}
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$INSTALL_FA3" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* && \
        git clone --depth 1 --branch ${FLASH_ATTN_VERSION} https://github.com/Dao-AILab/flash-attention.git /tmp/flash-attention && \
        pip install /tmp/flash-attention/hopper --no-build-isolation && \
        rm -rf /tmp/flash-attention; \
    fi

# Stage all flash-attn files for clean copy (version-agnostic)
# Layout: flash_attn/ (FA2 pkg), flash_attn_2_cuda.*.so, and optionally
#          flash_attn_3/ (FA3 pkg), flash_attn_interface.py, plus dist-info.
RUN mkdir /flash-attn-staging && \
    cp -r /opt/conda/lib/python3.11/site-packages/flash_attn /flash-attn-staging/ && \
    cp -r /opt/conda/lib/python3.11/site-packages/flash_attn-*.dist-info /flash-attn-staging/ && \
    for f in /opt/conda/lib/python3.11/site-packages/flash_attn_*_cuda.cpython-*.so; do \
        [ -f "$f" ] && cp "$f" /flash-attn-staging/; \
    done && \
    if [ "$INSTALL_FA3" = "true" ]; then \
        cp /opt/conda/lib/python3.11/site-packages/flash_attn_interface.py /flash-attn-staging/ && \
        cp -r /opt/conda/lib/python3.11/site-packages/flash_attn_3 /flash-attn-staging/ && \
        cp -r /opt/conda/lib/python3.11/site-packages/flash_attn_3*.dist-info /flash-attn-staging/; \
    fi

# Runtime stage
FROM pytorch/pytorch:${PYTORCH_VERSION} AS runtime

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Suppress hardlink warnings when cache mount is on a different filesystem
ENV UV_LINK_MODE=copy

# Required for torch.compile (inductor JIT-compiles Triton kernels via C/C++ compiler)
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled flash-attn from builder (package dir + dist-info + CUDA extensions)
COPY --from=builder /flash-attn-staging/ /opt/conda/lib/python3.11/site-packages/

# Install the transformers engine substrate plus the runtime non-engine deps
# llenergymeasure's host-import-time code expects when the project source is
# bind-mounted at runtime.
#
# Engine deps (transformers/accelerate/bitsandbytes/calflops + sentencepiece/einops)
# belong in the image because the engine runs only inside this image.
#
# Project runtime deps (pydantic/typer/pyyaml/platformdirs/nvidia-ml-py/numpy/
# pyarrow/tqdm/rich/python-dotenv/filelock) are baked in here because the
# upstream pytorch/pytorch base does not transitively bring them and the
# project is no longer pip-installed into this image — it is bind-mounted at
# /repo by the caller (`docker run -v $(pwd):/repo -e PYTHONPATH=/repo/src:/repo`).
# This list MUST stay in sync with `[project.dependencies]` in pyproject.toml;
# drift surfaces as ImportError at the first in-container run and is caught by
# the engine-invariants/engine-schemas workflow probe step.
ARG TRANSFORMERS_VERSION
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
        "transformers==${TRANSFORMERS_VERSION}" \
        "accelerate>=1.4" \
        "bitsandbytes>=0.45" \
        "calflops>=0.2" \
        sentencepiece einops \
        "pydantic>=2.0" "typer>=0.9" "pyyaml>=6.0" "platformdirs>=3.0" \
        "nvidia-ml-py>=12.0" "numpy>=1.24" "pyarrow>=14.0" "tqdm>=4.66" \
        "rich>=13.0" "python-dotenv>=1.0" filelock

# HuggingFace cache — writable for non-root users
ENV HF_HOME=/root/.cache/huggingface
RUN mkdir -p /root/.cache/huggingface && chmod 777 /root/.cache/huggingface

# Host/container schema handshake labels (see infra/version_handshake.py).
# LLEM_PKG_VERSION is the llenergymeasure release; LLEM_EXPCONF_SCHEMA_FINGERPRINT
# is a SHA-256 of ExperimentConfig.model_json_schema() at build time.
ARG LLEM_PKG_VERSION=dev
ARG LLEM_EXPCONF_SCHEMA_FINGERPRINT=unknown
LABEL org.opencontainers.image.version="${LLEM_PKG_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/henrycgbaker/llenergymeasure"
LABEL llem.expconf.schema.fingerprint="${LLEM_EXPCONF_SCHEMA_FINGERPRINT}"

# No CMD: the project is bind-mounted at /repo by the caller, so the image
# has nothing meaningful to invoke without an explicit command. Callers pass
# `--entrypoint python3 <image> -m <module>` (see docs/development.md and the
# engine-invariants/engine-schemas workflows).

# Dev stage — adds development tools for local iteration
FROM runtime AS dev
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system ruff mypy pytest pytest-cov
CMD ["/bin/bash"]
