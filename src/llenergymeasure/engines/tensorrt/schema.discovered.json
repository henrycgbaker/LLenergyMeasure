              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speculative Model"
        },
        "prompt_lookup_num_tokens": {
          "default": 2,
          "title": "Prompt Lookup Num Tokens",
          "type": "integer"
        },
        "max_matching_ngram_size": {
          "default": 4,
          "title": "Max Matching Ngram Size",
          "type": "integer"
        },
        "is_keep_all": {
          "default": true,
          "title": "Is Keep All",
          "type": "boolean"
        },
        "is_use_oldest": {
          "default": true,
          "title": "Is Use Oldest",
