{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "custom.regex", "pep621", "github-actions"],
  "gitIgnoredAuthors": ["llem-ci-bot[bot]"],
  "dockerfile": {
    "managerFilePatterns": [
      "/docker/Dockerfile\\..*/"
    ]
  },
  "pep621": {
    "managerFilePatterns": [
      "/(^|/)pyproject\\.toml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^engine_versions/(?:transformers|vllm|tensorrt)/current\\.yaml$/"
      ],
      "matchStrings": [
        "pep503_name: (?<depName>[\\w-]+)\\s*\\n\\s*current_version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["pytorch/pytorch"],
      "labels": ["renovate", "engine-transformers"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["transformers"],
      "labels": ["renovate", "engine-transformers"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["vllm"],
      "labels": ["renovate", "engine-vllm"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["tensorrt-llm"],
      "labels": ["renovate", "engine-tensorrt"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "replace"
    }
  ],
  "schedule": ["before 9am on Monday"],
  "prConcurrentLimit": 3,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "renovate"]
  },
  "labels": ["renovate"]
}
