{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "custom.regex", "pep621", "github-actions"],
  "dockerfile": {
    "fileMatch": ["docker/Dockerfile\\..*"]
  },
  "pep621": {
    "fileMatch": ["(^|/)pyproject\\.toml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^engine_versions/(?:transformers|vllm|tensorrt)/current\\.toml$"],
      "matchStrings": [
        "pep503_name\\s*=\\s*\"(?<depName>[\\w-]+)\"\\s*\\n\\s*current_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["vllm/vllm-openai"],
      "labels": ["renovate", "engine-vllm"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["nvcr.io/nvidia/tensorrt-llm/release"],
      "labels": ["renovate", "engine-tensorrt"],
      "registryUrls": ["https://nvcr.io"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["pytorch/pytorch"],
      "labels": ["renovate", "engine-transformers"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["transformers"],
      "labels": ["renovate", "engine-transformers"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["vllm"],
      "labels": ["renovate", "engine-vllm"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["tensorrt-llm"],
      "labels": ["renovate", "engine-tensorrt"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Only auto-PR when Mend merge-confidence signal is high or very-high. Filters out releases that other repos have flagged as unstable via CI / revert patterns.",
      "matchPackageNames": [
        "transformers",
        "vllm",
        "tensorrt-llm",
        "vllm/vllm-openai",
        "nvcr.io/nvidia/tensorrt-llm/release",
        "pytorch/pytorch"
      ],
      "matchConfidence": ["high", "very high"]
    }
  ],
  "schedule": ["before 9am on Monday"],
  "prConcurrentLimit": 3,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "renovate"]
  },
  "labels": ["renovate"]
}
