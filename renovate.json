{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": [
    "Policy: engine version pins (engine_versions/<engine>/current.yaml) bump ONE engine per PR.",
    "Each engine's regex-managed dep has its own packageRule with no shared groupName, so Renovate",
    "opens a separate branch/PR per engine (its default for distinct packages: transformers, vllm,",
    "tensorrt-llm). Do not add a shared groupName across engines. One engine per bump PR keeps the",
    "PR reviewable and its absorb diff self-contained (evidence: #792's 23-file single-engine bump",
    "vs #738's 82-file multi-engine diff)."
  ],
  "enabledManagers": ["dockerfile", "custom.regex", "pep621", "github-actions"],
  "gitIgnoredAuthors": ["llem-ci-bot[bot]"],
  "dockerfile": {
    "managerFilePatterns": [
      "/docker/Dockerfile\\..*/"
    ]
  },
  "pep621": {
    "managerFilePatterns": [
      "/(^|/)pyproject\\.toml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^engine_versions/(?:transformers|vllm|tensorrt)/current\\.yaml$/"
      ],
      "matchStrings": [
        "pep503_name: (?<depName>[\\w-]+)\\s*\\n\\s*current_version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["pytorch/pytorch"],
      "labels": ["renovate", "engine-transformers"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["transformers"],
      "description": "Engine pin: transformers. Own PR, one engine per bump (see top-level policy).",
      "labels": ["renovate", "engine-transformers"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["vllm"],
      "description": "Engine pin: vllm. Own PR, one engine per bump (see top-level policy).",
      "labels": ["renovate", "engine-vllm"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["tensorrt-llm"],
      "description": "Engine pin: tensorrt. Own PR, one engine per bump (see top-level policy).",
      "labels": ["renovate", "engine-tensorrt"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "replace"
    }
  ],
  "statusCheckNames": {
    "minimumReleaseAge": null
  },
  "schedule": ["before 9am on Monday"],
  "prConcurrentLimit": 3,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "renovate"]
  },
  "labels": ["renovate"]
}
